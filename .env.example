# ==============================================================================
# ClinAssist Environment Configuration Template
# Copy this file to .env and replace the placeholder values with your credentials.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Server Port
PORT=8080

# CORS Allowed Origins (Comma-separated for frontend access)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Connection String (Atlas or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/clinassist

# JWT Security Configuration (Secret key must be at least 256 bits long for HMAC-SHA256)
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long_example_ClinAssist2026!
JWT_EXPIRATION_MS=86400000

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# File Upload Configuration
MAX_REPORT_FILE_SIZE=10485760
